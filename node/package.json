{
  "name": "devlogs-node",
  "version": "2.3.2",
  "type": "module",
  "description": "Node.js logging library for DevLogs - forwards console logs to OpenSearch with async context isolation",
  "main": "dist/devlogs.cjs.js",
  "module": "dist/devlogs.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^11.1.6",
    "rollup": "^4.9.0",
    "tslib": "^2.6.2",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0",
    "@types/node": "^20.0.0"
  },
  "keywords": [
    "logging",
    "devlogs",
    "opensearch",
    "node",
    "console",
    "backend"
  ],
  "license": "MIT"
}
