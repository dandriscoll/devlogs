# Dockerfile combining Loki + the devlogs proxy in a single image.
#
# Loki listens on 127.0.0.1:3100 inside the container; the proxy talks to it
# over loopback and is the only port published.
#
# Build:
#   docker build -f Dockerfile.loki-proxy -t devlogs-loki-proxy .
#
# Run:
#   docker run -p 8080:8080 \
#     -e COLLECTOR_URL=http://collector:8081 \
#     -e GRAFANA_URL=http://grafana:3000 \
#     -e LOKI_ADMIN_TOKEN=<secret> \
#     -v devlogs-loki-data:/loki \
#     devlogs-loki-proxy

FROM grafana/loki:2.9.0 AS loki

FROM python:3.12-slim

# Loki is a static Go binary; copy it (and its config) out of the upstream image.
COPY --from=loki /usr/bin/loki /usr/local/bin/loki

WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
COPY src/ ./src/
COPY config/loki.yaml /etc/loki/local-config.yaml

RUN pip install --no-cache-dir -e ".[proxy]"

# Loki needs writable storage dirs (see config/loki.yaml).
RUN mkdir -p /loki/index /loki/index_cache /loki/chunks /loki/compactor \
 && useradd -r -u 1000 devlogs \
 && chown -R devlogs:devlogs /loki

USER devlogs

# Proxy reaches Loki over loopback inside the container.
ENV LOKI_URL=http://127.0.0.1:3100 \
    PORT=8080

EXPOSE 8080

# Run both processes; if either exits, the container exits.
CMD ["sh", "-c", "\
    loki -config.file=/etc/loki/local-config.yaml & loki_pid=$!; \
    python -m devlogs.proxy.server & proxy_pid=$!; \
    trap 'kill $loki_pid $proxy_pid 2>/dev/null' TERM INT; \
    wait -n $loki_pid $proxy_pid; \
    kill $loki_pid $proxy_pid 2>/dev/null; \
    wait \
"]
