# All-in-one devlogs image: proxy + collector + Loki in a single container.
#
# Inside the container:
#   Loki       127.0.0.1:3100   (log store)
#   Collector  127.0.0.1:8081   (forward mode → loki://127.0.0.1:3100)
#   Proxy      0.0.0.0:8080     (only port published)
#
# Routing through the proxy (unchanged from before):
#   POST /ingest/*   → Collector at 127.0.0.1:8081
#   GET  /query/*    → Loki at 127.0.0.1:3100        (Bearer LOKI_ADMIN_TOKEN)
#   GET  /grafana/*  → external GRAFANA_URL          (Bearer LOKI_ADMIN_TOKEN)
#
# The collector forwards into Loki via the loki:// plugin, so no on-disk
# buffer is used. Loki chunks/index live under /loki — mount a volume there
# for persistence.
#
# Build:
#   docker build -f Dockerfile.loki-proxy -t devlogs-loki-proxy .
#
# Run (anonymous ingest, the default):
#   docker run -p 8080:8080 \
#     -e LOKI_ADMIN_TOKEN=<secret-for-/query-and-/grafana> \
#     -e GRAFANA_URL=http://grafana:3000 \
#     -v devlogs-loki-data:/loki \
#     devlogs-loki-proxy
#
# Run (require a token on /ingest, mapped to a verified identity):
#   docker run -p 8080:8080 \
#     -e LOKI_ADMIN_TOKEN=<secret> \
#     -e DEVLOGS_AUTH_MODE=require_token_verified \
#     -e DEVLOGS_TOKEN_MAP_KV='dl1_kid_secret123=svc-foo,foo,service' \
#     -v devlogs-loki-data:/loki \
#     devlogs-loki-proxy
#
# Auth notes:
#   /query and /grafana require Authorization: Bearer $LOKI_ADMIN_TOKEN.
#   /ingest auth is governed by the collector's DEVLOGS_AUTH_MODE
#   (allow_anonymous | require_token_passthrough | require_token_verified)
#   and DEVLOGS_TOKEN_MAP_KV — see HOWTO-COLLECTOR.md. Default is
#   allow_anonymous so the image is usable out of the box.

FROM grafana/loki:2.9.0 AS loki

FROM python:3.12-slim

# Loki is a static Go binary; copy it (and its config) out of the upstream image.
COPY --from=loki /usr/bin/loki /usr/local/bin/loki

WORKDIR /app

COPY pyproject.toml README.md LICENSE ./
COPY src/ ./src/
COPY config/loki.yaml /etc/loki/local-config.yaml

# Base install brings in the collector (fastapi, uvicorn, opensearch-py, typer);
# the [proxy] extra adds aiohttp for the proxy server.
RUN pip install --no-cache-dir -e ".[proxy]"

# Loki needs writable storage dirs (see config/loki.yaml).
RUN mkdir -p /loki/index /loki/index_cache /loki/chunks /loki/compactor /loki/wal \
 && useradd -r -u 1000 devlogs \
 && chown -R devlogs:devlogs /loki

USER devlogs

# Proxy → collector → Loki, all over loopback inside the container.
ENV LOKI_URL=http://127.0.0.1:3100 \
    COLLECTOR_URL=http://127.0.0.1:8081 \
    DEVLOGS_FORWARD_URL=loki://127.0.0.1:3100 \
    DEVLOGS_AUTH_MODE=allow_anonymous \
    PORT=8080

EXPOSE 8080

# Run all three processes; if any exits, the container exits.
# Use bash explicitly: `wait -n` is a bash extension and dash (the default
# /bin/sh on debian-slim) errors out with "Illegal option -n".
CMD ["bash", "-c", "\
    loki -config.file=/etc/loki/local-config.yaml & loki_pid=$!; \
    devlogs-collector serve --host 127.0.0.1 --port 8081 & coll_pid=$!; \
    python -m devlogs.proxy.server & proxy_pid=$!; \
    trap 'kill $loki_pid $coll_pid $proxy_pid 2>/dev/null' TERM INT; \
    wait -n $loki_pid $coll_pid $proxy_pid; \
    kill $loki_pid $coll_pid $proxy_pid 2>/dev/null; \
    wait \
"]
